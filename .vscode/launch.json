{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch StoryBook (Dev Server + Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Launch Chrome (Existing Server)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Start All Services (Ecosystem)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run services:start"
    },
    {
      "name": "npm run dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    }
  ]
}
