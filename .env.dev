# ==============================================================================
# sb100: Dev / Local Environment Configuration (--mode dev)
# Secrets (GEMINI_API_KEY) should be placed in .env.local
# ==============================================================================
VITE_APP_ENV=dev
VITE_API_URL=http://localhost:8000
VITE_API_URL_AI=http://localhost:8002
VITE_API_URL_MEDIA=http://localhost:8003
VITE_ADMIN_DISPLAY_COMPONENT_NAME=true
VITE_ROBOTS=noindex, nofollow
VITE_ENABLE_LULU_PRINT=true

# Google Tag Manager & Google Analytics 4 (Development Placeholders)
VITE_GA_MEASUREMENT_ID=G-DEV-PLACEHOLDER
VITE_GTM_ID=GTM-DEV-PLACEHOLDER

